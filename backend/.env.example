# Database - for local development (sql.js file-based)
DATABASE_URL=./data/fintrack.db

# Turso - for production (cloud database)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:5173
